# Jev is the only model provider this app talks to. Create a key at
# https://typesafe.ai and paste it here. The file is git-ignored; nothing in the
# app ever prints the value, and provider errors are redacted before they reach
# the browser.
JEV_API_KEY=

# Optional. `jev-latest` follows the newest release; pin an exact version (for
# example jev-1.13.0) if you want today's verdicts to stay reproducible.
JEV_MODEL=jev-latest

# Optional. An exported YouTube cookies.txt in Netscape format, relative to the
# project root. See "Keeping YouTube signed in" in README.md: it must come from
# a private/incognito window that is never used for browsing afterwards.
YOUTUBE_COOKIES_PATH=./data/cookies.txt
